{
  "manifest_version": 3,
  "name": "Império IA · Conector C6",
  "description": "Conecta o Império IA ao portal C6 para simulações de refinanciamento, sem enviar a senha ao site.",
  "version": "0.1.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://c6.c6consig.com.br/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Configurar Conector C6"
  },
  "content_scripts": [
    {
      "matches": [
        "https://imperio-ia-consignado.grupo-imperio.chatgpt.site/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://c6.c6consig.com.br/*"],
      "js": ["c6-page-hooks.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://c6.c6consig.com.br/*"],
      "js": ["c6-content.js"],
      "run_at": "document_idle"
    }
  ]
}
